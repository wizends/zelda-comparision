---
import '../styles/global.css';
import SpeedInsights from '@vercel/speed-insights/astro';
import Seo from '../components/Seo.astro';
import { SEO_DESCRIPTION, SEO_TITLE } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = SEO_TITLE, description = SEO_DESCRIPTION, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} noindex={noindex} />
    <link rel="preload" as="image" href="/img/hero-remake.webp" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Cinzel:wght@500;700&family=Press+Start+2P&family=VT323&family=Nunito:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Fondos fijos de cada mitad (escritorio) -->
    <div class="bg bg-remake" aria-hidden="true">
      <div class="fairies"></div>
    </div>
    <div class="bg bg-n64" aria-hidden="true">
      <svg class="lowpoly" preserveAspectRatio="none"></svg>
      <div class="scanlines"></div>
    </div>
    <div class="seam" aria-hidden="true"><span class="seam-tri"></span></div>

    <slot />

    <!-- Métricas de rendimiento de Vercel (Speed Insights) -->
    <SpeedInsights />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
