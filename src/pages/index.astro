---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import Hero from '../components/Hero.astro';
import ChapterNav from '../components/ChapterNav.astro';
import ChapterSection from '../components/ChapterSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CompareModal from '../components/CompareModal.astro';
import MusicToggle from '../components/MusicToggle.astro';
import Timeline from '../components/Timeline.astro';
import NaviChat from '../components/NaviChat.astro';
import { CHAPTERS } from '../data/chapters';
---

<Layout>
  <TopBar />
  <Hero />
  <ChapterNav />
  <main id="app">
    {CHAPTERS.map((chapter, index) => <ChapterSection chapter={chapter} index={index} />)}
    <Timeline />
  </main>
  <SiteFooter />
  <CompareModal />
  <MusicToggle />
  <NaviChat />
</Layout>
