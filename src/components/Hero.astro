<section class="hero split" id="top">
  <div class="half half-l hero-l">
    <img class="hero-bg" src="/img/hero-remake.webp" alt="Link niño caminando por el bosque con Navi en el remake" fetchpriority="high" />
    <div class="hero-shade"></div>
    <div class="hero-content">
      <img class="hero-logo" src="/img/logo-remake.webp" alt="The Legend of Zelda: Ocarina of Time" />
      <p class="hero-tag">La leyenda, reconstruida</p>
      <p class="hero-sub">Nuevos modelos, iluminación volumétrica y un Hyrule redibujado para Nintendo Switch 2.</p>
    </div>
  </div>
  <div class="half half-r hero-r">
    <div class="poly-frame hero-screen">
      <img src="/img/title-n64.webp" alt="Pantalla de título original de Nintendo 64" />
      <span class="press-start">PRESS START</span>
    </div>
    <h1 class="retro-title"><span>LA LEYENDA</span><span>ORIGINAL</span></h1>
    <ul class="spec-list">
      <li><b>AÑO</b><span>1998</span></li>
      <li><b>RESOLUCIÓN</b><span>320×240</span></li>
      <li><b>CARTUCHO</b><span>256 Mbit</span></li>
    </ul>
    <div class="n64-buttons" aria-hidden="true">
      <i class="b-a"></i><i class="b-b"></i><i class="b-c"></i><i class="b-c"></i><i class="b-c"></i><i class="b-c"></i>
    </div>
  </div>
</section>
