# Clave de la YouTube Data API v3 (https://console.cloud.google.com/apis/library/youtube.googleapis.com)
# Se usa solo al compilar para buscar el vídeo de cada sección. No se envía al navegador.
YOUTUBE_API_KEY=

# URL pública de la web (canonical, sitemap, Open Graph). Por defecto: https://zelda-comparativa.wizends.dev
SITE_URL=
